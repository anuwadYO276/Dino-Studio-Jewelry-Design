generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============ Users ============
model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?
  company   String?
  country   String?
  role      UserRole @default(buyer)
  status    UserStatus @default(active)
  lastLogin DateTime? @map("last_login")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  otpTokens OtpToken[]
  sessions  Session[]
  inquiries Inquiry[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

enum UserRole {
  admin
  buyer
}

enum UserStatus {
  active
  inactive
}

// ============ OTP Tokens ============
model OtpToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String   @db.VarChar(6)
  type      OtpType
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_tokens")
}

enum OtpType {
  email
  phone
}

// ============ Sessions ============
model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @map("refresh_token") @db.Text
  userAgent    String?  @map("user_agent") @db.Text
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============ Products ============
model Product {
  id          String          @id @default(uuid())
  name        String          @db.VarChar(255)
  description String?         @db.Text
  category    ProductCategory
  collection  String?         @db.VarChar(100)
  status      ProductStatus   @default(new_arrival)
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  variants  Variant[]
  images    Image[]
  inquiries Inquiry[]

  @@index([category])
  @@index([status])
  @@index([isActive])
  @@index([collection])
  @@map("products")
}

enum ProductCategory {
  earring
  bracelet
  necklace
  ring
  pendant
  set
}

enum ProductStatus {
  new_arrival @map("new")
  seasonal
  sale
  discontinued
}

// ============ Variants ============
model Variant {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  sku       String       @unique @db.VarChar(50)
  color     String?      @db.VarChar(50)
  size      VariantSize?
  material  String?      @db.VarChar(100)
  price     Decimal      @db.Decimal(10, 2)
  minOrder  Int          @default(1) @map("min_order")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    Image[]
  inquiries Inquiry[]

  @@index([productId])
  @@index([sku])
  @@index([color])
  @@index([size])
  @@index([material])
  @@index([isActive])
  @@map("variants")
}

enum VariantSize {
  small
  medium
  large
  free_size @map("free-size")
}

// ============ Images ============
model Image {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  url       String  @db.Text
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([isPrimary])
  @@map("images")
}

// ============ Inquiries ============
model Inquiry {
  id         String        @id @default(uuid())
  userId     String?       @map("user_id")
  productId  String?       @map("product_id")
  variantId  String?       @map("variant_id")
  name       String        @db.VarChar(255)
  email      String?       @db.VarChar(255)
  company    String?       @db.VarChar(255)
  country    String?       @db.VarChar(100)
  message    String        @db.Text
  status     InquiryStatus @default(new_inquiry)
  adminNotes String?       @map("admin_notes") @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

enum InquiryStatus {
  new_inquiry @map("new")
  read
  responded
  closed
}
