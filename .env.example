# ============================
# Dino Studio - Environment Variables
# ============================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Gmail SMTP (Outgoing Email for OTP) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Dino Studio <your-email@gmail.com>"

# ---- SMS Gateway ----
SMS_MOCK=true
SMS_API_URL=https://your-sms-api-url/api/send-notification
SMS_AUTH=Basic your-base64-auth-token
SMS_SENDER=VL
SMS_SYSTEM=test_app
SMS_TYPE=ส่งOTP

# ---- Database (MySQL) ----
DB_SERVER=localhost
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_CHARSET=utf8
DATABASE_URL=mysql://username:password@localhost:3306/database_name

# ---- JWT ----
JWT_SECRET=generate-a-random-secret-here
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ---- OTP Config ----
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
